{
  "permissions": {
    "allow": [
      "Bash(./gradlew test*)",
      "Bash(./gradlew build*)",
      "Bash(./gradlew compileJava*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(kubectl get*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl top*)"
    ],
    "deny": [
      "Read(./**/*.env)",
      "Read(./**/*deployer.kubeconfig)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-verify.sh"
          }
        ]
      }
    ]
  }
}
